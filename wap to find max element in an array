#include <stdio.h>

int main() {
    int size, i, max_element;

    printf("Enter the number of elements in the array: ");
    scanf("%d", &size);

    int array[size]; 
    printf("Enter %d integers: \n", size);
    for (i = 0; i < size; i++) {
        printf("Element %d: ", i + 1);
        scanf("%d", &array[i]);
    }

    max_element = array[0];

    for (i = 1; i < size; i++) {
        if (array[i] > max_element) {
            max_element = array[i]; 
        }
    }

    printf("\nMaximum element found in the array is: %d\n", max_element);

    return 0;
}
