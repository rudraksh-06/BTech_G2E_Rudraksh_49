#include <stdio.h>
#include <stdbool.h>
bool areEqual(int mat1[][3], int mat2[][3], int rows, int cols) {

    for (int i = 0; i < rows; i++) {
        for (int j = 0; j < cols; j++) {
          
            if (mat1[i][j] != mat2[i][j]) {
                return false; 
            }
        }
    }

    return true;
}

int main() {
    int rows = 2;
    int cols = 3;

    int A[2][3] = {{1, 2, 3}, {4, 5, 6}};
    int B[2][3] = {{1, 2, 3}, {4, 5, 6}};
    int C[2][3] = {{1, 2, 3}, {4, 5, 9}}; 
    if (areEqual(A, B, rows, cols)) {
        printf("Matrix A and Matrix B are equal.\n");
    } else {
        printf("Matrix A and Matrix B are not equal.\n");
    }

    if (areEqual(A, C, rows, cols)) {
        printf("Matrix A and Matrix C are equal.\n");
    } else {
        printf("Matrix A and Matrix C are not equal.\n");
    }

    return 0;
}
